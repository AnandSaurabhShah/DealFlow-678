DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dealflow360?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
CUSTOMER_JWT_SECRET="replace-with-a-different-long-random-secret"
JWT_EXPIRES_IN="7d"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
CUSTOMER_PORTAL_URL="http://localhost:5173"

# Optional SMTP delivery. Without SMTP_HOST the quotation is still shared in
# the portal, but no email is sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="DealFlow360 <no-reply@example.com>"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_REP_PASSWORD="Rep12345!"
SEED_MANAGER_PASSWORD="Manager123!"
SEED_FINANCE_PASSWORD="Finance123!"
SEED_CUSTOMER_PASSWORD="Customer123!"
SEED_CUSTOMER_B_PASSWORD="CustomerB123!"
