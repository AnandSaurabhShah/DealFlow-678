// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  REP
  MANAGER
  FINANCE
}

enum QuotationStatus {
  DRAFT
  PENDING_MANAGER_APPROVAL
  PENDING_FINANCE_APPROVAL
  APPROVED
  REJECTED
  CONFIRMED
  FULFILLED
  SENT_TO_CUSTOMER
  UNDER_NEGOTIATION
}

enum ApprovalAction {
  APPROVED
  REJECTED
  RETURNED
}

enum BillingType {
  ONE_TIME
  RECURRING
}

enum BillingCycle {
  MONTHLY
}

enum ScheduleEntryStatus {
  PENDING
  BILLED
  CANCELLED
}

enum CommentAuthorType {
  CUSTOMER
  INTERNAL
}

enum NegotiationEventAction {
  SENT_TO_CUSTOMER
  DISCOUNT_UPDATED
  CUSTOMER_CONFIRMED
  APPROVAL_REENTRY
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role
  quotations   Quotation[]
  approvalLogs ApprovalLog[]
  createdAt    DateTime      @default(now())
}

model Customer {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  quotations   Quotation[]
  createdAt    DateTime    @default(now())
}

model Product {
  id                String             @id @default(uuid())
  name              String
  category          String
  price             Decimal
  unit              String
  tax               Decimal            @default(0)
  description       String?
  billingType       BillingType        @default(ONE_TIME)
  billingCycle      BillingCycle?
  quotationLines    QuotationLine[]
  stockLevels       StockLevel[]
  fulfillmentSplits FulfillmentSplit[]
  createdAt         DateTime           @default(now())
}

model PriceList {
  id           String   @id @default(uuid())
  name         String
  customerTier String
  currency     String   @default("USD")
  createdAt    DateTime @default(now())
}

model Warehouse {
  id                String             @id @default(uuid())
  name              String
  location          String?
  stockLevels       StockLevel[]
  fulfillmentSplits FulfillmentSplit[]
  createdAt         DateTime           @default(now())
}

model StockLevel {
  id          String    @id @default(uuid())
  warehouseId String
  productId   String
  qty         Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
}

model DiscountTier {
  id                 String                     @id @default(uuid())
  tierName           String                     @unique
  maxDiscountPercent Decimal
  categoryOverrides  CategoryDiscountOverride[]
  createdAt          DateTime                   @default(now())
}

model CategoryDiscountOverride {
  id                 String       @id @default(uuid())
  discountTierId     String
  category           String
  maxDiscountPercent Decimal
  discountTier       DiscountTier @relation(fields: [discountTierId], references: [id])

  @@unique([discountTierId, category])
}

model Quotation {
  id                  String               @id @default(uuid())
  customerName        String
  repId               String
  customerId          String?
  status              QuotationStatus      @default(DRAFT)
  subtotal            Decimal              @default(0)
  totalDiscount       Decimal              @default(0)
  grandTotal          Decimal              @default(0)
  blendedRiskScore    Decimal              @default(0)
  approvalRound       Int                  @default(0)
  sentToCustomerAt    DateTime?
  rep                 User                 @relation(fields: [repId], references: [id])
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines               QuotationLine[]
  approvalLogs        ApprovalLog[]
  negotiationComments NegotiationComment[]
  negotiationEvents   NegotiationEvent[]
  fulfillmentSplits   FulfillmentSplit[]
  invoices            Invoice[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([customerId])
}

model QuotationLine {
  id                     String                 @id @default(uuid())
  quotationId            String
  productId              String
  qty                    Int
  unitPrice              Decimal
  discountPercent        Decimal                @default(0)
  lineTotal              Decimal
  billingType            BillingType            @default(ONE_TIME)
  billingCycle           BillingCycle?
  subscriptionStartDate  DateTime?
  quotation              Quotation              @relation(fields: [quotationId], references: [id])
  product                Product                @relation(fields: [productId], references: [id])
  billingScheduleEntries BillingScheduleEntry[]
  creditNotes            CreditNote[]
  negotiationComments    NegotiationComment[]
  negotiationEvents      NegotiationEvent[]
}

model ApprovalLog {
  id            String         @id @default(uuid())
  quotationId   String
  actorId       String
  action        ApprovalAction
  approvalRound Int            @default(0)
  reason        String?
  createdAt     DateTime       @default(now())
  quotation     Quotation      @relation(fields: [quotationId], references: [id])
  actor         User           @relation(fields: [actorId], references: [id])

  @@index([quotationId, createdAt])
  @@index([actorId])
}

model NegotiationComment {
  id              String            @id @default(uuid())
  quotationId     String
  quotationLineId String?
  authorType      CommentAuthorType
  authorId        String
  content         String
  quotation       Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationLine   QuotationLine?    @relation(fields: [quotationLineId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())

  @@index([quotationId, createdAt])
  @@index([quotationLineId])
  @@index([authorType, authorId])
}

model NegotiationEvent {
  id              String                 @id @default(uuid())
  quotationId     String
  quotationLineId String?
  actorType       CommentAuthorType
  actorId         String
  action          NegotiationEventAction
  details         Json?
  quotation       Quotation              @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationLine   QuotationLine?         @relation(fields: [quotationLineId], references: [id], onDelete: SetNull)
  createdAt       DateTime               @default(now())

  @@index([quotationId, createdAt])
  @@index([quotationLineId])
  @@index([actorType, actorId])
}

model FulfillmentSplit {
  id             String    @id @default(uuid())
  quotationId    String
  warehouseId    String
  productId      String
  qtyFulfilled   Int
  qtyBackordered Int       @default(0)
  quotation      Quotation @relation(fields: [quotationId], references: [id])
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  product        Product   @relation(fields: [productId], references: [id])
  createdAt      DateTime  @default(now())

  @@unique([quotationId, warehouseId, productId])
  @@index([warehouseId])
  @@index([productId])
}

model BillingScheduleEntry {
  id              String              @id @default(uuid())
  quotationLineId String
  billingDate     DateTime
  amount          Decimal
  status          ScheduleEntryStatus @default(PENDING)
  quotationLine   QuotationLine       @relation(fields: [quotationLineId], references: [id])
  createdAt       DateTime            @default(now())

  @@unique([quotationLineId, billingDate])
  @@index([billingDate, status])
}

model Invoice {
  id          String      @id @default(uuid())
  quotationId String
  amount      Decimal
  type        BillingType
  paid        Boolean     @default(false)
  quotation   Quotation   @relation(fields: [quotationId], references: [id])
  createdAt   DateTime    @default(now())

  @@index([quotationId])
}

model CreditNote {
  id              String        @id @default(uuid())
  quotationLineId String
  amount          Decimal
  reason          String
  quotationLine   QuotationLine @relation(fields: [quotationLineId], references: [id])
  createdAt       DateTime      @default(now())

  @@index([quotationLineId])
}
