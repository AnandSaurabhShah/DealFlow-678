// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  REP
  MANAGER
  FINANCE
}

enum QuotationStatus {
  DRAFT
  PENDING_MANAGER_APPROVAL
  PENDING_FINANCE_APPROVAL
  APPROVED
  REJECTED
  CONFIRMED
}

enum ApprovalAction {
  APPROVED
  REJECTED
  RETURNED
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         Role
  quotations   Quotation[]
  approvalLogs ApprovalLog[]
  createdAt    DateTime    @default(now())
}

model Product {
  id             String          @id @default(uuid())
  name           String
  category       String
  price          Decimal
  unit           String
  tax            Decimal         @default(0)
  description    String?
  quotationLines QuotationLine[]
  stockLevels    StockLevel[]
  createdAt      DateTime        @default(now())
}

model PriceList {
  id           String   @id @default(uuid())
  name         String
  customerTier String
  currency     String   @default("USD")
  createdAt    DateTime @default(now())
}

model Warehouse {
  id          String       @id @default(uuid())
  name        String
  location    String?
  stockLevels StockLevel[]
  createdAt   DateTime     @default(now())
}

model StockLevel {
  id          String    @id @default(uuid())
  warehouseId String
  productId   String
  qty         Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
}

model DiscountTier {
  id                 String                     @id @default(uuid())
  tierName           String                     @unique
  maxDiscountPercent Decimal
  categoryOverrides  CategoryDiscountOverride[]
  createdAt          DateTime                   @default(now())
}

model CategoryDiscountOverride {
  id                 String       @id @default(uuid())
  discountTierId     String
  category           String
  maxDiscountPercent Decimal
  discountTier       DiscountTier @relation(fields: [discountTierId], references: [id])

  @@unique([discountTierId, category])
}

model Quotation {
  id            String          @id @default(uuid())
  customerName  String
  repId         String
  status        QuotationStatus @default(DRAFT)
  subtotal      Decimal         @default(0)
  totalDiscount Decimal         @default(0)
  grandTotal    Decimal         @default(0)
  blendedRiskScore Decimal      @default(0)
  rep           User            @relation(fields: [repId], references: [id])
  lines         QuotationLine[]
  approvalLogs  ApprovalLog[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model QuotationLine {
  id              String    @id @default(uuid())
  quotationId     String
  productId       String
  qty             Int
  unitPrice       Decimal
  discountPercent Decimal   @default(0)
  lineTotal       Decimal
  quotation       Quotation @relation(fields: [quotationId], references: [id])
  product         Product   @relation(fields: [productId], references: [id])
}

model ApprovalLog {
  id          String         @id @default(uuid())
  quotationId String
  actorId     String
  action      ApprovalAction
  reason      String?
  createdAt   DateTime       @default(now())
  quotation   Quotation      @relation(fields: [quotationId], references: [id])
  actor       User           @relation(fields: [actorId], references: [id])

  @@index([quotationId, createdAt])
  @@index([actorId])
}
